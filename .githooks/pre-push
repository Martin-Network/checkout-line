#!/bin/sh
# Last check before anything becomes public: clean commit history, green build.
set -eu

hooks_dir=$(dirname "$0")
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Deleting a remote branch: nothing to check
    case $local_sha in *[!0]*) ;; *) continue ;; esac

    case $remote_sha in
        *[!0]*) range="$remote_sha..$local_sha" ;;
        *) range="$local_sha --not --remotes" ;;   # new branch: everything not pushed yet
    esac

    # shellcheck disable=SC2086
    if ! sh "$hooks_dir/check-commit-messages.sh" $range; then
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    exit 1
fi

echo "Running ./gradlew check before pushing..." >&2
./gradlew check --quiet
